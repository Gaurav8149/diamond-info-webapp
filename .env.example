# Copy this file to .env and fill in real values.

PORT=3000

# Folder on disk where certificate/parcel images & videos live
MEDIA_FOLDER_PATH=./sample-media

IMAGE_EXTENSIONS=jpg,jpeg,png,bmp
VIDEO_EXTENSIONS=mp4,avi

# Optional: leave DB_SERVER blank to disable the external-video-link DB lookup entirely.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
